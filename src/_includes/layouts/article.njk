{% extends "layouts/base.njk" %}
{% block content %}
<article><header class="article-header"><h1 class="article-title">{{ post.title | escape }}</h1></header><div class="entry-content">{{ content | safe }}</div>{% set newer = posts | getItem(pagination.pageNumber - 1) %}{% set older = posts | getItem(pagination.pageNumber + 1) %}<nav class="article-nav" aria-label="前後の記事">{% if newer %}<a class="article-nav-link" href="/{{ newer.slug }}/"><span class="article-nav-label">← 前の記事</span><span class="article-nav-title">{{ newer.title | escape }}</span></a>{% else %}<span class="article-nav-link article-nav-empty" aria-hidden="true"></span>{% endif %}{% if older %}<a class="article-nav-link next" href="/{{ older.slug }}/"><span class="article-nav-label">次の記事 →</span><span class="article-nav-title">{{ older.title | escape }}</span></a>{% else %}<span class="article-nav-link article-nav-empty" aria-hidden="true"></span>{% endif %}</nav></article>
{% endblock %}
