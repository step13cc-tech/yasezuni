{% for post in items %}<a class="post-card" href="/{{ post.slug }}/">{% if post.image %}<div class="post-card-thumb"><img src="{{ post.image }}" alt="" loading="lazy"></div>{% else %}<div class="post-card-thumb" aria-hidden="true"></div>{% endif %}<div class="post-card-copy"><h2>{{ post.title | escape }}</h2><p class="post-excerpt">{{ post.excerpt | escape }}</p></div></a>{% endfor %}
