{
  "name": "yasezuni-static-site",
  "private": true,
  "scripts": {
    "build": "npm run check:images && npm run prepare:publication && eleventy",
    "check:images": "node scripts/check-image-uniqueness.mjs",
    "prepare:publication": "node scripts/build-publication-data.mjs",
    "start": "npm run prepare:publication && eleventy --serve",
    "migrate-data": "node scripts/extract-eleventy-data.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  }
}
